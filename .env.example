POSTGRES_USER=domain
POSTGRES_PASSWORD=domain
POSTGRES_DB=domain
DATABASE_URL=postgresql://domain:domain@postgres:5432/domain

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=domain
RABBITMQ_PASSWORD=domain
RABBITMQ_QUEUE=domain_processing

DNS_TIMEOUT_SECONDS=5
HTTP_CONNECT_TIMEOUT_SECONDS=5
HTTP_READ_TIMEOUT_SECONDS=10
CLAIM_STALE_SECONDS=45
